# Android CI / provider connection checks
AI_CHAT_PROVIDER_TYPE=custom
AI_CHAT_PROVIDER_BASE_URL=https://your-api-provider.example.com
AI_CHAT_PROVIDER_API_KEY=sk-your-provider-api-key-here
AI_CHAT_IMAGE_API_KEY=sk-your-image-api-key-here
AI_CHAT_IMAGE_ENDPOINT_PATH=/v1/images/generations

# scripts/test/newapi_smoke.ps1
NEWAPI_API_KEY=sk-your-newapi-key-here
NEWAPI_IMAGE_KEY=sk-your-newapi-image-key-here

# GitHub Actions secrets:
# - AI_CHAT_PROVIDER_BASE_URL
# - AI_CHAT_PROVIDER_API_KEY
# - AI_CHAT_IMAGE_API_KEY

# Brave Search API Key (for web search integration)
BRAVE_SEARCH_API_KEY=your-brave-search-api-key-here
