{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aichat.local/contracts/gateway/tool-manifest.schema.json",
  "title": "ToolManifest",
  "type": "object",
  "required": ["version", "generatedAt", "tools"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "permissionLevel", "inputSchema"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "permissionLevel": {
            "enum": ["ReadOnly", "Network", "Execute", "HighRisk"]
          },
          "inputSchema": {
            "type": "object"
          },
          "outputSchema": {
            "type": "object"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
