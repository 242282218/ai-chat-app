{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aichat.local/contracts/gateway/sandbox-run.schema.json",
  "title": "SandboxRunResponse",
  "type": "object",
  "required": ["language", "stdout", "stderr", "exitCode", "durationMs", "timedOut", "truncated"],
  "additionalProperties": false,
  "properties": {
    "language": {
      "enum": ["python"]
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    },
    "exitCode": {
      "type": "integer"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "timedOut": {
      "type": "boolean"
    },
    "truncated": {
      "type": "boolean"
    }
  }
}
