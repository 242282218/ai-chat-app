{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aichat.local/contracts/gateway/search.schema.json",
  "title": "SearchResponse",
  "type": "object",
  "required": ["query", "fetchedAt", "results"],
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1
    },
    "fetchedAt": {
      "type": "string",
      "format": "date-time"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "summary", "url", "source"],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "source": {
            "type": "string"
          },
          "publishedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        }
      }
    }
  }
}
