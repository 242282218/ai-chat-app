{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aichat.local/contracts/gateway/error.schema.json",
  "title": "GatewayError",
  "type": "object",
  "required": ["code", "message"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": ["string", "null"]
    },
    "details": {
      "type": ["object", "null"]
    }
  }
}
